{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "read": {
      "*": "ask",
      "*.md": "allow",
      "src/**": "allow",
      "tests/**": "allow",
      ".env*": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "ask",
      "src/**": "ask",
      "tests/**": "ask",
      "AGENTS.md": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow"
    }
  }
}
