{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/rules/safety.md",
    "~/.config/opencode/rules/workflow.md",
    "~/.config/opencode/rules/rust.md",
    "~/.config/opencode/rules/gleam.md"
  ],
  "permission": {
    "read": {
      "*": "ask",
      "*.md": "allow",
      "src/**": "allow",
      "tests/**": "allow",
      ".env*": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "ask",
      "src/**": "ask",
      "tests/**": "allow",
      "AGENTS.md": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow"
    }
  },
  "mcp": {
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "darkstardevx"
      }
    }
  }
}
